<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_interfaces</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="nianan_0311@qq.com">qiu</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 定义消息的包中加入一下内容 -->
  <build_depend>rosidl_default_generators</build_depend>
  <!-- rosidl_default_generators(build_depend) 构建期用rosidl生成器把.msg变成C++/python代码 -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- rosidl_default_runtime(exec_depend) 运行期需要的接口运行时库 -->
  <member_of_group>rosidl_interface_packages</member_of_group>
  <!-- member_of_group rosidl_interface_packages 声明这是接口包，让rosidl正确处理 -->
  <!-- ====================== -->

  <depend>rclcpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
